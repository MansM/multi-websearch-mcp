# Provider API keys (leave unset to skip that provider)
OLLAMA_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
# BRAVE_SEARCH_API_KEY=   # alternative name also accepted

# Ordered list of providers to try (first success wins)
SEARCH_PROVIDERS=ollama,tavily,brave,searxng

# SearXNG – prefer a self-hosted instance
SEARXNG_URL=http://localhost:8080/search
# Optional comma-separated fallbacks
SEARXNG_FALLBACK_URLS=

SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=15

# HTTP server (Open WebUI external endpoint & MCP)
SERVER_HOST=0.0.0.0
SERVER_PORT=8018
# If set, Open WebUI must send the same value as EXTERNAL_WEB_SEARCH_API_KEY
EXTERNAL_SEARCH_API_KEY=
